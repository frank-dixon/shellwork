# Copy to .env for local dev.
DEBUG=true
# Required when DEBUG=false (bin/publish sets a throwaway one for freezing).
SECRET_KEY=
# Comma-separated; defaults to localhost/127.0.0.1 when DEBUG=true.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Optional: use Postgres etc. instead of the SQLite db.sqlite3.
DATABASE_URL=
TIME_ZONE=America/New_York
# bin/publish: path to a frank-dixon.github.io checkout (or pass --repo).
SHELLWORK_PAGES_REPO=../frank-dixon.github.io
